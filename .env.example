# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Endereço público do app (usado nos links enviados por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta (Supabase > Project Settings > API > service_role).
# Usada só no servidor para a empresa cadastrar/convidar clientes.
# NUNCA compartilhe nem coloque em código. Configure direto na Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# Notificações no celular (gere em Painel > Configurações dentro do app)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# E-mails de aviso (opcional) — resend.com
RESEND_API_KEY=
EMAIL_REMETENTE=

# Lembretes automáticos diários (gere em Painel > Configurações)
CRON_SECRET=

# Google Agenda (veja docs/GOOGLE_AGENDA.md)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_CALENDAR_ID=
