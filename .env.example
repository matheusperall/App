# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Endereço público do app (usado nos links enviados por e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Chave secreta (Supabase > Project Settings > API > service_role).
# Usada só no servidor para a empresa cadastrar/convidar clientes.
# NUNCA compartilhe nem coloque em código. Configure direto na Vercel.
SUPABASE_SERVICE_ROLE_KEY=
